            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Outro\",\n  \"cnpj\": \"34.028.316/0001-03\",\n  \"email\": \"marcos@anota.com\",\n  \"senha\": \"123456\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Rota sem token (401)",
          "request": {
            "method": "GET",
            "header": [],
