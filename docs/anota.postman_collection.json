              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Fiz a pintura da casa da Joana Silva, ficou 1.500 reais\"\n}"
            },
            "description": "Se tiver IA_API_KEY no .env usa o Claude, se nao usa a busca de palavras. O campo origem diz qual foi usado ('ia' ou 'simulacao')."
          }
        },
