# copiar esse arquivo para .env e trocar pelos dados do seu postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=anota

# porta da api
PORT=3001

# segredo pra assinar o token do login (JWT)
# troca por qualquer texto grande e dificil, nao deixa esse em producao
JWT_SECRET=troque-esse-segredo-por-um-texto-grande
# quanto tempo o login vale
JWT_EXPIRA=8h

# IA (Claude da Anthropic) - opcional
# se deixar vazio o sistema usa a interpretacao simulada
IA_API_KEY=
IA_MODELO=claude-opus-5-5

# email (SMTP) - opcional
# se deixar vazio o sistema usa uma conta de teste do Ethereal (o email nao chega de verdade,
# mas a api devolve um link pra ver como ficou)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# quem aparece como remetente (se vazio usa o SMTP_USER)
SMTP_FROM=
